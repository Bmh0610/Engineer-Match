监听
python3 -c "
import serial, time
s = serial.Serial('/dev/ttyTHS1', 115200, timeout=0.1)
print('监听 /dev/ttyTHS1, 现在从电脑端发数据... Ctrl-C 停')
buf = b''
try:
    while True:
        d = s.read(256)
        if d:
            buf += d
            print(time.strftime('%H:%M:%S'), repr(d), d.hex(' '))
except KeyboardInterrupt:
    pass
print('共收到', len(buf), '字节')"

